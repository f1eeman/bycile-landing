---
import { Font } from 'astro:assets'
import Seo from '@/components/seo.astro'
import Header from '@/components/header.astro'
import Footer from '@/components/footer.astro'
import type { NavKey } from '@/data/navigation'

import '@/styles/index.css'

interface Props {
  title: string
  description: string
  theme: 'dark' | 'light'
  current?: NavKey
  cartCount?: number
}

const { title, description, ...header } = Astro.props
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo {title} {description} />
    <Font cssVariable="--font-roboto-serif" preload />
    <Font cssVariable="--font-roboto" preload={[{ weight: 400 }]} />
  </head>
  <body>
    <Header {...header} />
    <main>
      <slot />
    </main>
    <Footer theme={header.theme} />
    <script>
      import { initReveal } from '@/scripts/reveal'
      import { initParallax } from '@/scripts/parallax'
      import { initRequestForm } from '@/scripts/request-form'

      initReveal()
      initParallax()
      initRequestForm()
    </script>
  </body>
</html>
