---
import CatalogLink from '@/components/catalog-link.astro'
import ProductCard from '@/components/product-card.astro'
import { ACCESSORIES } from '@/data/products'
---

<section class="parts" id="parts" aria-labelledby="parts-title">
  <div class="container">
    <div class="content-column">
      <div class="intro" data-reveal>
        <h3 class="title" id="parts-title">Запчасти и&nbsp;аксессуары</h3>
        <p class="lead">
          Всегда большой выбор запчастей и&nbsp;аксессуаров для чоппер-байков.
          Если вы чего-то не нашли в&nbsp;наличии, наши консультанты помогут
          заказать и&nbsp;доставить товар из любой точки мира.
        </p>
      </div>
      <ul class="cards" data-reveal data-reveal-stagger>
        {
          ACCESSORIES.map((product) => (
            <li>
              <ProductCard {product} kind="part" heading="h4" />
            </li>
          ))
        }
      </ul>
      <div data-reveal>
        <CatalogLink label={'Перейти в\u00A0каталог'} />
      </div>
    </div>
  </div>
</section>

<style>
  .parts {
    padding-block: 82px 95px;
  }

  .intro {
    text-align: center;
  }

  .title {
    font-family: var(--font-head);
    font-weight: 400;
    font-size: var(--text-heading-size);
    line-height: var(--text-heading-leading);
    letter-spacing: var(--text-heading-tracking);
    text-transform: uppercase;
  }

  .lead {
    max-inline-size: 745px;
    margin-block-start: 5.5px;
    margin-inline: auto;
  }

  .cards {
    display: grid;
    grid-template-columns: 224px;
    row-gap: 32px;
    justify-content: center;
    margin-block: 64.5px 70px;
  }

  @media (width >= 575px) {
    .cards {
      grid-template-columns: repeat(2, 224px);
      column-gap: 58.67px;
    }
  }

  @media (width >= 1179px) {
    .cards {
      grid-template-columns: repeat(4, 224px);
    }
  }
</style>
