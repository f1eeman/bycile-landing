---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'input'>

const props = Astro.props
---

<input {...props} />

<style>
  input {
    --field-error: var(--color-error-inverse);

    inline-size: 100%;
    max-inline-size: 100%;
    block-size: var(--control-height);
    padding-inline: 16px;
    border: 1px solid var(--color-accent-inverse);
    border-radius: 0;
    background-color: transparent;
    color: var(--color-text-inverse);
    letter-spacing: inherit;
    caret-color: var(--color-text-inverse);
    transition: border-color 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  input::placeholder {
    color: color-mix(in srgb, var(--color-text-inverse) 50%, transparent);
    opacity: 1;
  }

  input:autofill {
    box-shadow: inset 0 0 0 100vmax var(--color-surface-inverse);
    -webkit-text-fill-color: var(--color-text-inverse);
  }

  @media (hover: hover) and (pointer: fine) {
    input:hover {
      border-color: var(--color-text-inverse);
    }
  }

  input[aria-invalid='true'] {
    border-color: var(--field-error);
  }

  input:focus-visible {
    border-color: var(--color-text-inverse);
    outline: 3px solid
      color-mix(in srgb, var(--color-accent-inverse) 35%, transparent);
    outline-offset: 0;
  }

  input[aria-invalid='true']:focus-visible {
    border-color: var(--field-error);
    outline-color: color-mix(in srgb, var(--field-error) 35%, transparent);
  }

  input:active {
    border-color: var(--color-text-inverse);
  }

  input[aria-invalid='true']:active {
    border-color: var(--field-error);
  }

  @media (prefers-reduced-motion: reduce) {
    input {
      transition: none;
    }
  }
</style>
