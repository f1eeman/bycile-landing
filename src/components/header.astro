---
import { HEADER_LINKS, type NavKey } from '@/data/navigation'
import Logo from '@/img/icons/logo.svg'
import LogoMuted from '@/img/icons/logo-muted.svg'
import User from '@/img/icons/user.svg'
import Search from '@/img/icons/search.svg'
import Basket from '@/img/icons/basket.svg'

interface Props {
  theme: 'dark' | 'light'
  current?: NavKey
  cartCount?: number
}

const { theme, current, cartCount } = Astro.props

const LogoIcon = theme === 'dark' ? Logo : LogoMuted

const ariaCurrentOf = (link: (typeof HEADER_LINKS)[number]) => {
  if (link.key !== current) return undefined

  return link.href === Astro.url.pathname ? 'page' : 'true'
}

const cartLabel =
  cartCount === undefined ? 'Корзина' : `Корзина, товаров: ${String(cartCount)}`
---

<header class:list={['header', `theme-${theme}`]}>
  <div class="container">
    <div class="row wide-row">
      <a class="logo" href="/">
        <LogoIcon class="logo-image" aria-hidden="true" />
        <span class="visually-hidden">Chopper Bikeshop — на главную</span>
      </a>

      <details class="menu" data-menu>
        <summary
          class="menu-toggle"
          data-menu-toggle
          data-menu-label-open="Открыть меню"
          data-menu-label-close="Закрыть меню"
        >
          <span class="visually-hidden" data-menu-label>Открыть меню</span>
          <span class="burger" aria-hidden="true"></span>
        </summary>
        <nav class="nav" aria-label="Разделы магазина">
          <ul class="nav-list">
            {
              HEADER_LINKS.map((link) => (
                <li>
                  <a
                    class:list={[
                      'nav-link',
                      { 'small-caps': theme === 'light' },
                    ]}
                    href={link.href}
                    aria-current={ariaCurrentOf(link)}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>

      <ul class="tools">
        <li>
          <button class="tool" type="button">
            <User aria-hidden="true" />
            <span class="visually-hidden">Личный кабинет пользователя</span>
          </button>
        </li>
        <li>
          <button class="tool" type="button">
            <Search aria-hidden="true" />
            <span class="visually-hidden">Поиск</span>
          </button>
        </li>
        <li>
          <button class="tool" type="button">
            <Basket aria-hidden="true" />
            <span class="visually-hidden">{cartLabel}</span>
            {
              cartCount !== undefined && (
                <span class="count" aria-hidden="true">
                  {cartCount}
                </span>
              )
            }
          </button>
        </li>
      </ul>
    </div>
  </div>
</header>

<script>
  import { initMenu } from '@/scripts/menu'

  initMenu()
</script>

<style>
  .header {
    --header-ring: var(--color-accent);
    --header-hover: var(--color-text);
    --header-panel: var(--color-bg);
    --header-gap: 30.5px;

    position: relative;
    z-index: 10;
  }

  .theme-dark {
    --header-ring: var(--color-text-inverse);
    --header-hover: var(--color-accent-inverse);
    --header-panel: var(--color-surface-inverse);
    --header-gap: 24.5px;

    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
  }

  .row {
    display: flex;
    gap: 24px;
    align-items: center;
    block-size: 104px;
  }

  .theme-light .row {
    box-sizing: content-box;
    border-block-end: var(--rule-width) solid var(--color-rule);
  }

  .logo {
    flex: 0 1 184px;
    min-inline-size: 0;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
  }

  .logo-image {
    inline-size: 100%;
    block-size: auto;
  }

  .logo:focus-visible,
  .tool:focus-visible,
  .menu-toggle:focus-visible,
  .nav-link:focus-visible {
    outline: 2px solid var(--header-ring);
    outline-offset: 4px;
  }

  .tools {
    display: flex;
    flex: none;
    column-gap: 24px;
    align-items: center;
  }

  .tools li:first-child {
    margin-inline-end: 4px;
  }

  .tool {
    position: relative;
    display: block;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
    transition: transform 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .tool::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    inline-size: 44px;
    block-size: 44px;
    translate: -50% -50%;
  }

  .tool:active {
    transform: scale(0.97);
    transition-duration: 90ms;
  }

  .count {
    position: absolute;
    inset-block-start: calc(100% + 1.5px);
    inset-inline-start: 10px;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--text-body-s-size);
    line-height: var(--text-body-s-leading);
    color: var(--color-accent);
  }

  .nav-link {
    display: block;
    padding-block: 13px;
    font-family: var(--font-head);
    font-weight: 400;
    font-size: var(--text-nav-size);
    line-height: var(--text-nav-leading);
    letter-spacing: var(--text-nav-tracking);
    white-space: nowrap;
    color: var(--color-text-muted);
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition: color 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .theme-dark .nav-link {
    text-transform: uppercase;
  }

  .nav-link[aria-current] {
    color: var(--color-accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .tool:hover {
      transform: translateY(-2px);
    }
  }

  @media (width < 1179px) {
    .logo {
      margin-inline-end: auto;
    }

    .menu {
      flex: none;
    }

    .menu-toggle {
      position: relative;
      display: grid;
      place-content: center;
      inline-size: 24px;
      block-size: 24px;
      list-style: none;
      cursor: pointer;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
    }

    .menu-toggle::-webkit-details-marker {
      display: none;
    }

    .menu-toggle::after {
      content: '';
      position: absolute;
      inset: -10px;
    }

    .burger,
    .burger::before,
    .burger::after {
      inline-size: 20px;
      block-size: 2px;
      background-color: var(--color-text-muted);
      transition:
        transform 180ms cubic-bezier(0.2, 0.8, 0.25, 1),
        background-color 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
    }

    .burger {
      position: relative;
    }

    .burger::before,
    .burger::after {
      content: '';
      position: absolute;
      inset-inline-start: 0;
    }

    .burger::before {
      inset-block-start: -6px;
    }

    .burger::after {
      inset-block-start: 6px;
    }

    .menu-toggle:active .burger,
    .menu-toggle:active .burger::before,
    .menu-toggle:active .burger::after {
      background-color: var(--header-hover);
      transition-duration: 90ms;
    }

    @media (hover: hover) and (pointer: fine) {
      .menu-toggle:hover .burger::before,
      .menu-toggle:hover .burger::after {
        background-color: var(--header-hover);
      }
    }

    .menu[open] .burger,
    .menu[open] .menu-toggle:active .burger {
      background-color: transparent;
    }

    .menu[open] .burger::before {
      transform: translateY(6px) rotate(45deg);
    }

    .menu[open] .burger::after {
      transform: translateY(-6px) rotate(-45deg);
    }

    .menu::details-content {
      transition: content-visibility 180ms allow-discrete;
    }

    .nav {
      position: absolute;
      inset-inline: 0;
      inset-block-start: 100%;
      z-index: 1;
      block-size: 0;
      max-block-size: calc(100dvh - 100%);
      background-color: var(--header-panel);
      overflow: hidden auto;
      transition: block-size 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
    }

    .theme-light .nav {
      border-block-end: var(--rule-width) solid var(--color-rule);
    }

    .menu[open] .nav {
      block-size: auto;
    }

    .nav-list {
      padding-block: 8px 16px;
      padding-inline: var(--layout-gutter);
    }

    .nav-link {
      transition-property: color, background-color;
    }

    .nav-link:active {
      background-color: color-mix(
        in srgb,
        var(--header-panel) 92%,
        var(--header-hover)
      );
      color: var(--header-hover);
      transition-duration: 90ms;
    }

    @media (hover: hover) and (pointer: fine) {
      .nav-link:not([aria-current]):hover {
        color: var(--header-hover);
      }
    }
  }

  @media (width >= 1179px) {
    .header {
      --header-slack: min(100vw - 1179px, 12px);
    }

    .row {
      column-gap: var(--header-gap);
      justify-content: space-between;
    }

    .theme-light .menu {
      margin-inline-end: calc(var(--header-slack) / 2);
    }

    .theme-light .nav-list li:nth-child(3) {
      margin-inline-start: calc(var(--header-slack) * 5 / 12);
    }

    .theme-light .nav-list li:nth-child(5) {
      margin-inline-start: calc(var(--header-slack) / 12);
    }

    .theme-dark .nav-list li:nth-child(3) {
      margin-inline-start: 4.5px;
    }

    .theme-dark .nav-list li:nth-child(4),
    .theme-dark .nav-list li:nth-child(5) {
      margin-inline-start: 1px;
    }

    .theme-dark .nav-list li:nth-child(6) {
      margin-inline-start: -2.5px;
    }

    .menu-toggle {
      display: none;
    }

    .menu::details-content {
      block-size: auto;
      content-visibility: visible;
    }

    .nav-list {
      display: flex;
      column-gap: var(--header-gap);
    }

    .nav-link {
      position: relative;
      transition-property: color, transform;
    }

    .nav-link::after {
      content: '';
      position: absolute;
      inset-block-end: 9px;
      inset-inline: 0;
      block-size: var(--rule-width);
      background-color: currentcolor;
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
    }

    .nav-link:active {
      transform: scale(0.97);
      transition-duration: 90ms;
    }

    @media (hover: hover) and (pointer: fine) {
      .nav-link:not([aria-current]):hover {
        color: var(--header-hover);
      }

      .nav-link:hover::after {
        transform: scaleX(1);
        transform-origin: left;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav,
    .nav-link,
    .nav-link::after,
    .tool,
    .burger,
    .burger::before,
    .burger::after,
    .menu::details-content {
      transition: none;
    }

    .nav-link:active,
    .tool:active {
      transform: none;
    }
  }
</style>
