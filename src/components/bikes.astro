---
import CatalogLink from '@/components/catalog-link.astro'
import ProductCard from '@/components/product-card.astro'
import { SHOWCASE_BIKES } from '@/data/products'

const LEAD = [
  'Бесплатный выездной тест-драйв на все модели. Система рассрочки 0-0-5.',
  'Для членов клуба бесплатно предоставляется выездной сервис,',
  'зимнее хранение и\u00A0куча привилегий от партнеров.',
] as const
---

<section class="bikes" id="bikes" aria-labelledby="bikes-title">
  <div class="container">
    <div class="content-column">
      <div class="intro" data-reveal>
        <h3 class="title" id="bikes-title">
          У&nbsp;нас более 200 моделей прогулочных велосипедов для настоящих
          мужчин
        </h3>
        <p class="lead">
          {LEAD.map((line) => <span class="line">{line} </span>)}
        </p>
      </div>
      <ul class="cards" data-reveal data-reveal-stagger>
        {
          SHOWCASE_BIKES.map((product) => (
            <li>
              <ProductCard {product} kind="bike" heading="h4" />
            </li>
          ))
        }
      </ul>
      <div data-reveal>
        <CatalogLink label="Все велосипеды" />
      </div>
    </div>
  </div>
</section>

<style>
  .bikes {
    padding-block: 82px 95px;
  }

  .intro {
    text-align: center;
  }

  .title {
    max-inline-size: 800px;
    margin-inline: auto;
    font-family: var(--font-head);
    font-weight: 400;
    font-size: var(--text-heading-size);
    line-height: var(--text-heading-leading);
    letter-spacing: var(--text-heading-tracking);
    text-transform: uppercase;
  }

  .lead {
    margin-block-start: 5.5px;
  }

  .cards {
    display: grid;
    grid-template-columns: 224px;
    row-gap: 32px;
    justify-content: center;
    margin-block: 82.5px 71px;
  }

  @media (width >= 575px) {
    .cards {
      grid-template-columns: repeat(2, 224px);
      column-gap: 58.67px;
    }
  }

  @media (575px <= width < 978px) {
    .cards li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      justify-self: center;
    }
  }

  @media (width >= 978px) {
    .cards {
      grid-template-columns: repeat(3, 224px);
      column-gap: 105.5px;
    }

    .line {
      display: block;
    }
  }
</style>
