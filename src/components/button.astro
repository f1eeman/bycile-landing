---
import type { HTMLTag, Polymorphic } from 'astro/types'

type Props<Tag extends HTMLTag = 'button'> = Polymorphic<{ as: Tag }> & {
  variant?: 'outline' | 'accent'
  tone?: 'dark' | 'light'
  size?: 'md' | 'lg'
}

const {
  as: Tag = 'button',
  class: className,
  variant = 'outline',
  tone = 'light',
  size = 'md',
  ...attrs
} = Astro.props
---

<Tag
  class:list={[
    'base-button',
    `variant-${variant}`,
    variant === 'outline' && `tone-${tone}`,
    `size-${size}`,
    className,
  ]}
  {...attrs}
>
  <slot />
</Tag>

<style>
  .base-button {
    --cap-shift: 6px;

    position: relative;
    display: inline-flex;
    gap: 10px;
    align-items: center;
    justify-content: center;
    block-size: var(--control-height);
    padding-block-start: var(--cap-shift);
    font-family: var(--font-head);
    font-weight: 400;
    font-size: var(--text-button-size);
    line-height: 1;
    letter-spacing: var(--text-button-tracking);
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
    transition:
      background-color 180ms cubic-bezier(0.2, 0.8, 0.25, 1),
      transform 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  :where(.size-md) {
    inline-size: 240px;
  }

  :where(.size-lg) {
    inline-size: 273px;
  }

  .variant-outline {
    border: 1px solid var(--outline-border);
    background-color: transparent;
    color: var(--outline-text);
  }

  .tone-dark {
    --outline-border: var(--color-accent-inverse);
    --outline-text: var(--color-accent-inverse);
  }

  .tone-light {
    --outline-border: var(--color-text-muted);
    --outline-text: var(--color-text);
  }

  .variant-accent {
    background-color: var(--color-accent);
    color: var(--color-text-inverse);
  }

  .base-button > :global(svg) {
    margin-block-end: var(--cap-shift);
  }

  @media (hover: hover) and (pointer: fine) {
    .base-button:hover {
      transform: translateY(-2px);
    }

    .variant-outline:hover {
      background-color: color-mix(
        in srgb,
        var(--outline-border) 12%,
        transparent
      );
    }

    .variant-accent:hover {
      background-color: color-mix(in srgb, var(--color-accent) 88%, #fff);
    }
  }

  .base-button:focus-visible {
    transform: translateY(-2px);
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .tone-dark:focus-visible {
    outline-color: var(--color-accent-inverse);
  }

  .base-button:active {
    transform: translateY(0) scale(0.97);
    transition-duration: 90ms;
  }

  .variant-outline:active {
    background-color: color-mix(in srgb, var(--outline-border) 6%, transparent);
  }

  .variant-accent:active {
    background-color: color-mix(in srgb, var(--color-accent) 85%, #000);
  }

  @media (prefers-reduced-motion: reduce) {
    .base-button {
      transition: background-color 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
    }

    .base-button:focus-visible,
    .base-button:active {
      transform: none;
    }

    @media (hover: hover) and (pointer: fine) {
      .base-button:hover {
        transform: none;
      }
    }
  }
</style>
