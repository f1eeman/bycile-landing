---
import Layout from '@/layouts/Layout.astro'
import Breadcrumbs from '@/components/breadcrumbs.astro'
import ProductInfo from '@/components/product-info.astro'
import ProductTabs from '@/components/product-tabs.astro'
import Related from '@/components/related.astro'
import { ACCESSORIES, STEED_G67 } from '@/data/products'

const title = 'Седло Steed G67 — Chopper Bikeshop'
const description =
  'Седло Steed G67. В комплекте ключ для регулировки, газета с полезной информацией и рекомендациями по уходу от компании-производителя.'
---

<Layout {title} {description} theme="light" current="accessories" cartCount={1}>
  <Breadcrumbs trail={STEED_G67.trail} />
  <ProductInfo product={STEED_G67} />
  <ProductTabs product={STEED_G67} />
  <Related products={ACCESSORIES} />
</Layout>
