---
import Layout from '@/layouts/Layout.astro'

const title = 'Политика конфиденциальности — Chopper Bikeshop'
const description =
  'Политика конфиденциальности магазина Chopper Bikeshop. Текст политики готовится.'
---

<Layout {title} {description} theme="light">
  <section class="page">
    <div class="container">
      <div class="content-column">
        <h1 class="title">Политика конфиденциальности</h1>
        <p class="lead">Текст политики готовится.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page {
    padding-block: 82px 95px;
  }

  .title {
    font-family: var(--font-head);
    font-weight: 400;
    font-size: var(--text-title-size);
    line-height: var(--text-title-leading);
    letter-spacing: var(--text-title-tracking);
    text-transform: uppercase;
    color: var(--color-text);
  }

  .lead {
    margin-block-start: 5.5px;
    color: var(--color-text);
  }

  @media (width >= 575px) {
    .title {
      font-size: var(--text-heading-size);
      line-height: var(--text-heading-leading);
      letter-spacing: var(--text-heading-tracking);
    }
  }
</style>
